        {
          "name": "Ubah Toddler",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Berat berubah, nama tetap', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData.beratKg).to.eql(12);\r\n  pm.expect(jsonData.nama).to.eql('Nadia');\r\n});\r\n"
                ]
              }
            }
