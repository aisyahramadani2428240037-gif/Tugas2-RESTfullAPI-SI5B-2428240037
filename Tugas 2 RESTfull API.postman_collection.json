    {
      "name": "A. CRUD",
      "item": [
        {
          "name": "Semua Toddler",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Response berupa array', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.be.an('array');\r\n});\r\n\r\npm.test('Setiap data memiliki id dan nama', function () {\r\n  const jsonData = pm.response.json();\r\n  jsonData.forEach((item) => {\r\n    pm.expect(item).to.have.property('id');\r\n    pm.expect(item).to.have.property('nama');\r\n  });\r\n});\r\n\r\npm.test('Response time di bawah 500ms', function () {\r\n  pm.expect(pm.response.responseTime).to.be.below(500);\r\n});\r\n\r\npm.test('Data toddler pertama bernama Alya', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData[0].nama).to.eql('Alya');\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/toddler",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "toddler"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Tambah Toddler",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 201', function () {\r\n  pm.response.to.have.status(201);\r\n});\r\n\r\npm.test('Data baru memiliki id dan nama sesuai kiriman', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.have.property('id');\r\n  pm.expect(jsonData.nama).to.eql('Nadia');\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n  pm.environment.set('toddlerId', pm.response.json().id);\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{x-api-key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nama\": \"Nadia\",\r\n  \"tanggalLahir\": \"2023-04-15\",\r\n  \"jenisKelamin\": \"P\",\r\n  \"beratKg\": 11,\r\n  \"tinggiCm\": 82\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/toddler",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "toddler"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Satu Toddler",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code adalah 200', function () {\r\n  pm.response.to.have.status(200);\r\n});\r\n\r\npm.test('Data yang diambil adalah Nadia', function () {\r\n  const jsonData = pm.response.json();\r\n  pm.expect(jsonData.id).to.eql(Number(pm.environment.get('toddlerId')));\r\n  pm.expect(jsonData.nama).to.eql('Nadia');\r\n});\r\n"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/toddler/{{toddlerId}}",
              "host": [
